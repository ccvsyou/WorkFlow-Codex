APP_NAME=FlowCodex
APP_ENV=production
# Generate with: openssl rand -hex 24
API_TOKEN=replace-with-a-long-random-token

# LLM: deepseek | openai-compatible | mock
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180

# Runtime
DATA_DIR=/data
REPOS_ROOT=/repos
FEASIBILITY_THRESHOLD=60
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1.0
VERIFY_TIMEOUT=300

# Safety: patches are generated in an isolated git worktree. Set true to auto-commit.
AUTO_APPLY_PATCH=false

# Optional Obsidian export. Mount the vault into the container.
OBSIDIAN_VAULT_PATH=/vault
OBSIDIAN_FOLDER=WorkFlow-Codex

# Caddy: :80 for IP-only, or your domain for automatic HTTPS
SITE_ADDRESS=:80
DATA_HOST_DIR=./data
REPOS_HOST_DIR=./repos
OBSIDIAN_HOST_DIR=./vault
